---
import IndexLayout from '../layouts/IndexLayout.astro';
import { pageTitle } from '../data/site';
---
<IndexLayout title={pageTitle('About')} description="IoT and custom software engineer. I help companies design and ship software for connected products.">
  <div class="py-14">
    <header class="masthead">
      <div class="masthead-text">
        <p class="eyebrow mono"><span class="dot"></span>ABOUT</p>
        <h1 class="page-title">About me</h1>
        <p class="lede">Hi, I'm Berkay and I solve problems.</p>
      </div>
      <img src="/images/berkay.png" alt="Berkay Çubuk" class="avatar" width="320" height="320" />
    </header>

    <div class="prose prose-lg measure mt-10">
      <p>What I do:</p>
      <ul>
        <li>Develop custom dashboards and internal tools</li>
        <li>Lightweight and cross platform tools to get the job done</li>
        <li>LLM integrations (Claude, GPT, DeepSeek, GLM, etc.)</li>
        <li>Blockchain applications</li>
      </ul>
    </div>

    <section class="block">
      <h2 class="mono block-label"><span class="dot"></span>WORKING TOGETHER</h2>
      <p class="lede">
        If you have a problem worth a 20-minute conversation, grab a free slot on
        my calendar.
      </p>
      <a href="https://cal.com/berkaycubuk/discovery-call" target="_blank" rel="noopener noreferrer" class="btn">
        Book a call &rarr;
      </a>
    </section>
  </div>
</IndexLayout>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .masthead-text { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }
  .avatar {
    flex-shrink: 0;
    width: 320px;
    height: auto;
    aspect-ratio: 1 / 1;
    max-width: 100%;
    border-radius: 50%;
  }
  @media (max-width: 560px) {
    .masthead { flex-direction: column-reverse; align-items: flex-start; }
    .avatar { width: 220px; }
  }

  .block {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .block-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    color: var(--color-text);
  }
  .block .lede { margin-bottom: 20px; }
  .links a { color: var(--color-text); text-decoration: none; }
</style>
