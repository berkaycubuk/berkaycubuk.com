---
import IndexLayout from '../layouts/IndexLayout.astro';
import { pageTitle } from '../data/site';
---
<IndexLayout title={pageTitle('About')} description="Hardware and software engineer in Istanbul. I build custom devices, sensors and automation software for factories and workshops.">
  <div class="py-14">
    <header class="masthead">
      <div class="masthead-text">
        <p class="eyebrow mono"><span class="dot"></span>ABOUT</p>
        <h1 class="page-title">About me</h1>
        <p class="lede">Hi, I'm Berkay and I solve problems.</p>
      </div>
      <img src="/images/berkay.png" alt="Berkay Çubuk" class="avatar" width="320" height="320" />
    </header>

    <div class="prose prose-lg measure mt-10">
      <p>What I do:</p>
      <ul>
        <li>Custom devices — indicators, controllers and small machines built for a specific floor</li>
        <li>Sensors and monitoring, so you can see what your machines are doing without walking over</li>
        <li>Automation software and internal tools that connect equipment, screens and people</li>
        <li>Remote configuration and updates over MQTT, so what I install keeps working without me on site</li>
      </ul>
    </div>

    <section class="block">
      <h2 class="mono block-label"><span class="dot"></span>WORKING TOGETHER</h2>
      <p class="lede">
        Tell me what's wasting your team's time, in plain words. I reply within a
        day.
      </p>
      <a href="mailto:berkay@berkaycubuk.com" class="btn">
        Email me &rarr;
      </a>
    </section>
  </div>
</IndexLayout>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .masthead-text { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }
  .avatar {
    flex-shrink: 0;
    width: 320px;
    height: auto;
        max-width: 100%;
    background: var(--print);
    padding: 8px 8px 30px;
    box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 14px 34px -16px rgba(0,0,0,.35);
    transform: rotate(3deg);
  }
  @media (max-width: 560px) {
    .masthead { flex-direction: column-reverse; align-items: flex-start; }
    .avatar { width: 220px; }
  }

  .block {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .block-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    color: var(--color-text);
  }
  .block .lede { margin-bottom: 20px; }
  .links a { color: var(--color-text); text-decoration: none; }
</style>
