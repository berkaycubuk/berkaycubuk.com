---
import IndexLayout from '../layouts/IndexLayout.astro';
import { pageTitle } from '../data/site';
---
<IndexLayout title={pageTitle('About')} description="IoT and custom software engineer. I help companies design and ship software for connected products.">
  <div class="py-14">
    <header class="masthead">
      <p class="eyebrow mono"><span class="dot"></span>ABOUT</p>
      <h1 class="page-title">About me</h1>
      <p class="lede">Hi, I'm Berkay — I help companies design and ship software for connected products.</p>
    </header>

    <div class="prose prose-lg measure mt-10">
      <p>
        I'm a problem solver. I design and build custom software — with a focus on
        IoT and connected products — and I write and tinker along the way.
      </p>
      <p>
        I work independently, solving real problems for people and businesses
        mostly through software, and sometimes hardware.
      </p>
      <p>What I build:</p>
      <ul>
        <li>Custom IoT dashboards & device software</li>
        <li>Web platforms and internal tools</li>
        <li>LLM integrations (Claude, GPT, DeepSeek, etc.)</li>
        <li>Blockchain applications</li>
      </ul>
    </div>

    <section class="block">
      <h2 class="mono block-label"><span class="dot"></span>WORKING TOGETHER</h2>
      <p class="lede">
        If you have a problem worth a 20-minute conversation, grab a free slot on
        my calendar.
      </p>
      <a href="https://cal.com/berkaycubuk/discovery-call" target="_blank" rel="noopener noreferrer" class="btn">
        Book a call &rarr;
      </a>
    </section>
  </div>
</IndexLayout>

<style>
  .masthead { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }

  .block {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .block-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    color: var(--color-text);
  }
  .block .lede { margin-bottom: 20px; }
  .links a { color: var(--color-text); text-decoration: none; }
</style>
