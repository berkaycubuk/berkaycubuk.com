---
import IndexLayout from '../layouts/IndexLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { pageTitle } from '../data/site';
---
<IndexLayout title={pageTitle('Projects')} description="Projects and things I've built — IoT, custom software, web and blockchain.">
  <div class="py-14">
    <header class="masthead">
      <p class="eyebrow mono"><span class="dot"></span>SELECTED WORK</p>
      <h1 class="page-title">Projects</h1>
      <p class="lede">Things I've built and am working on.</p>
    </header>

    <div class="list">
      {projects.map(project => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          links={project.links}
        />
      ))}
    </div>
  </div>
</IndexLayout>

<style>
  .masthead { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }
  .list { margin-top: 40px; }
</style>
