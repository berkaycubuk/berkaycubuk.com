---
import { CollectionEntry, getCollection } from 'astro:content';
import IndexLayout from '../layouts/IndexLayout.astro';
import moment from 'moment';

export async function getStaticPaths() {
	const posts = await getCollection('writings');
  return posts.map((post) => {
    const fullPath = `${moment(post.data.date).format('YYYY/MM/DD')}/${post.slug}`;

    return {
      params: { slug: fullPath },
      props: post,
    }
  });
}
type Props = CollectionEntry<'writings'>;

const post = Astro.props;
const { Content } = await post.render();

const description = post.data.description || post.body.split('\n').find(line => line.trim().length > 0)?.substring(0, 160) || post.data.title;
const formattedDate = moment(post.data.date).format('MMM DD, YYYY');
const isoDate = moment(post.data.date).toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": description,
  "datePublished": isoDate,
  "dateModified": post.data.date_updated ? moment(post.data.date_updated).toISOString() : isoDate,
  "author": {
    "@type": "Person",
    "name": "Berkay Cubuk",
    "url": "https://berkaycubuk.com/about"
  },
  "url": `https://berkaycubuk.com/${moment(post.data.date).format('YYYY/MM/DD')}/${post.slug}/`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://berkaycubuk.com/${moment(post.data.date).format('YYYY/MM/DD')}/${post.slug}/`
  }
};
---
<IndexLayout title={post.data.title} description={description} type="article" jsonLd={jsonLd}>
  <article class="py-14 measure">
    <a href="/writings" class="mono ulink back">&larr; Writings</a>

    <header class="post-head">
      <time datetime={isoDate} class="mono date">{formattedDate}</time>
      <h1 class="post-title">{post.data.title}</h1>
    </header>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <div class="foot">
      <a href="/writings" class="mono ulink">&larr; All writings</a>
    </div>
  </article>
</IndexLayout>

<style>
  .back { display: inline-block; color: var(--color-text-secondary); text-decoration: none; }
  .post-head { margin: 28px 0 32px; }
  .date { color: var(--color-text-tertiary); }
  .post-title {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 54px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text);
    overflow-wrap: break-word;
  }
  .foot {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .foot a { color: var(--color-text); text-decoration: none; }
</style>
