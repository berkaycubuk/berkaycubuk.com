---
import IndexLayout from '../layouts/IndexLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { pageTitle } from '../data/site';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');
---
<IndexLayout title={pageTitle('Tools')} description="Tools I've built to solve real problems.">
  <div class="py-14">
    <header class="masthead">
      <p class="eyebrow mono"><span class="dot"></span>UTILITIES</p>
      <h1 class="page-title">Tools</h1>
      <p class="lede">Tools I've developed to solve real problems.</p>
    </header>

    <div class="list">
      {tools.map((tool: any) => (
        <ToolCard
          title={tool.data.title}
          icon={tool.data.icon}
          href={`/tools/${tool.slug}`}
          description={tool.data.description}
        />
      ))}
    </div>
  </div>
</IndexLayout>

<style>
  .masthead { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }
  .list { margin-top: 40px; }
</style>
