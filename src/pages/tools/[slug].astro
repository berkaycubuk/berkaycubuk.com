---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import { pageTitle } from '../../data/site';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: tool,
  }));
}

const tool = Astro.props;
const { Content } = await tool.render();

const description = tool.data.description || tool.data.title;
---
<IndexLayout title={pageTitle(tool.data.title)} description={description}>
  <div class="py-14 measure">
    <a href="/tools" class="mono ulink back">&larr; Tools</a>

    <header class="tool-head">
      <img src={tool.data.icon} alt={`${tool.data.title} icon`} class="icon" />
      <div>
        <h1 class="page-title small">{tool.data.title}</h1>
        {tool.data.version && <p class="mono ver">v{tool.data.version}</p>}
      </div>
    </header>

    <article class="prose prose-lg max-w-none">
      <Content />
    </article>

    <script define:vars={{ toolName: tool.data.title }}>
      document.querySelectorAll('article a[href*="static.berkaycubuk.com/tool-binaries"]').forEach((link) => {
        const filename = link.href.split('/').pop();
        link.setAttribute('data-umami-event', `${toolName} download`);
        link.setAttribute('data-umami-event-file', filename);
      });
    </script>

    <div class="foot">
      <a href="/tools" class="mono ulink">&larr; All tools</a>
    </div>
  </div>
</IndexLayout>

<style>
  .back { display: inline-block; color: var(--color-text-secondary); text-decoration: none; }
  .tool-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 28px 0 8px;
  }
  .icon {
    width: 88px;
    height: 88px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }
  .page-title.small { font-size: clamp(30px, 6vw, 52px); }
  .ver { margin: 8px 0 0; color: var(--color-text-tertiary); }
  .foot {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .foot a { color: var(--color-text); text-decoration: none; }
</style>
