---
import IndexLayout from '../layouts/IndexLayout.astro';
import { pageTitle } from '../data/site';
import { getCollection } from 'astro:content';
import moment from 'moment';

const blogPosts = await getCollection('writings');
const sortedPosts = blogPosts.sort((a, b) => moment(b.data.date).valueOf() - moment(a.data.date).valueOf());
---
<IndexLayout
  title={pageTitle('Writings')}
  description="One of the greatest things about humans is that we can express our thoughts and type them into text."
>
  <div class="py-14">
    <header class="masthead">
      <p class="eyebrow mono"><span class="dot"></span>NOTES &amp; ESSAYS</p>
      <h1 class="page-title">Writings</h1>
      <p class="lede">
        One of the greatest things about humans is that we can express our
        thoughts and type them into text.
      </p>
    </header>

    <div class="list">
      {sortedPosts.map((post: any) => (
        <a
          href={'/' + moment(post.data.date).format('YYYY/MM/DD') + '/' + post.slug}
          class="entry post"
        >
          <time class="mono date">{moment(post.data.date).format('YYYY · MMM DD')}</time>
          <div class="body">
            <h2 class="title">{post.data.title}</h2>
            {post.data.description && <p class="desc">{post.data.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </div>
</IndexLayout>

<style>
  .masthead { display: flex; flex-direction: column; gap: 14px; }
  .masthead .lede { margin-top: 6px; }
  .list { margin-top: 40px; }

  .post {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 6px 32px;
    padding: 26px 0;
  }
  .date { color: var(--color-text-tertiary); padding-top: 6px; }
  .title {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.15s ease;
  }
  .post:hover .title { color: var(--color-text-secondary); }
  .desc {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 66ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .post { grid-template-columns: 1fr; gap: 8px; }
    .date { padding-top: 0; }
  }
</style>
