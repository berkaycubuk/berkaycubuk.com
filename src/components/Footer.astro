---
import ThemeToggle from './ThemeToggle.astro';

// `plain` drops the "write to me" line — the homepage already ends on one.
interface Props { lang?: 'en' | 'tr'; plain?: boolean }
const { lang = 'en', plain = false } = Astro.props;

const currentYear = new Date().getFullYear();

const T = {
  en: { ask: 'Something on your floor wasting time?', write: 'Write to me', nav: ['Writings', 'Notes', 'Projects', 'Tools', 'About'] },
  tr: { ask: 'Atölyenizde vakit kaybettiren bir şey mi var?', write: 'Bana yazın', nav: ['Yazılar', 'Notlar', 'Projeler', 'Araçlar', 'Hakkımda'] },
}[lang];

const nav = ['/writings', '/notes', '/projects', '/tools', '/about'].map((href, i) => ({ label: T.nav[i], href }));

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/berkaycubuk',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'X',
    href: 'https://x.com/brkycubuk',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/berkaycubuk',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
  {
    label: 'Email',
    href: 'mailto:berkay@berkaycubuk.com',
    path: 'M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z',
  },
];
---
<footer class="site-footer">
  {!plain && (
    <div class="ask">
      <p class="mono dim">{T.ask}</p>
      <a class="write" href="mailto:berkay@berkaycubuk.com">{T.write} <span>→</span></a>
    </div>
  )}
  <div class="top">
    <nav class="nav" aria-label="Footer">
      {nav.map((n) => <a class="ulink" href={n.href}>{n.label}</a>)}
    </nav>
    <ThemeToggle />
  </div>
  <div class="bottom">
    <span class="mono dim">&copy; {currentYear} Berkay&nbsp;Çubuk · Istanbul</span>
    <div class="socials">
      {socials.map(s => (
        <a
          class="social"
          href={s.href}
          aria-label={s.label}
          {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 0 var(--pad) 40px; margin-top: 100px; }
  .ask { border-top: 1px solid var(--color-border); padding: 70px 0 60px; }
  .ask .mono { margin: 0 0 18px; }
  .write {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(56px, 10vw, 150px);
    line-height: .9;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-decoration: none;
    transition: letter-spacing .4s ease;
  }
  .write span { font-style: normal; font-size: .6em; }
  @media (hover: hover) { .write:hover { letter-spacing: -0.01em; } }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 15px;
  }
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 22px;
  }
  .nav { display: flex; flex-wrap: wrap; gap: 22px; }
  .dim { color: var(--color-text-tertiary); }
  .socials { display: flex; align-items: center; gap: 26px; margin-right: 13px; }
  /* 18px icon, 44px tap area. */
  .social { display: block; line-height: 0; padding: 13px; margin: -13px; color: var(--color-text-secondary); }
  .social:hover { color: var(--color-text); }
</style>
