---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  links?: { label: string; href: string }[];
}

const { title, description, tags = [], links = [] } = Astro.props;
---
<article class="entry project">
  <div class="meta">
    {tags.length > 0 && (
      <div class="tags mono">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}
  </div>
  <div class="body">
    <h3 class="title">{title}</h3>
    <p class="desc">{description}</p>
    {links.length > 0 && (
      <div class="links">
        {links.map(link => (
          <a href={link.href} {...(link.href.startsWith('/') ? {} : { target: "_blank", rel: "noopener noreferrer" })} class="mono ulink">
            {link.label} &rarr;
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 10px 32px;
    padding: 30px 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    color: var(--color-text-tertiary);
    font-size: 10px;
    padding-top: 6px;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .desc {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 62ch;
  }
  .links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; }
  .links a { color: var(--color-text); text-decoration: none; }

  @media (max-width: 640px) {
    .project { grid-template-columns: 1fr; gap: 12px; }
    .tags { padding-top: 0; order: 2; margin-top: 4px; }
    .body { order: 1; }
  }
</style>
