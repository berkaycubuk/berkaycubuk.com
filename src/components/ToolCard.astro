---
interface Props {
  title: string;
  icon: string;
  href: string;
  description?: string;
}

const { title, icon, href, description } = Astro.props;
---
<a href={href} class="entry tool">
  <img src={icon} alt={`${title} icon`} class="icon" />
  <div class="body">
    <h3 class="title">{title}</h3>
    {description && <p class="desc">{description}</p>}
  </div>
  <span class="arrow mono">&rarr;</span>
</a>

<style>
  .tool {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 0;
  }
  .icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }
  .body { flex: 1; min-width: 0; }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-text);
    transition: color 0.15s ease;
  }
  .desc {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .arrow {
    color: var(--color-text-tertiary);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .tool:hover .arrow { transform: translateX(3px); color: var(--color-text); }
</style>
