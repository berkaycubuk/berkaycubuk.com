---
const nav = [
  { label: 'Writings', href: '/writings' },
  { label: 'Notes', href: '/notes' },
  { label: 'Projects', href: '/projects' },
  { label: 'Tools', href: '/tools' },
  { label: 'About', href: '/about' },
];
---
<header class="site-header shell">
  <div class="bar">
    <a class="wordmark mono" href="/">Berkay&nbsp;Çubuk</a>

    <!-- Desktop nav -->
    <div class="right">
      <nav class="nav">
        {nav.map(n => (
          <a class="nav-link mono ulink" href={n.href}>{n.label}</a>
        ))}
      </nav>
      <button id="mobile-menu-btn" class="menu-btn" aria-label="Open menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="mobile-menu hidden">
    {nav.map(n => (
      <a class="nav-link mono" href={n.href}>{n.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header { padding-top: 20px; padding-bottom: 14px; }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
  }
  .wordmark {
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .wordmark:hover { color: var(--color-text-secondary); }

  .right { display: flex; align-items: center; gap: 22px; }
  .nav { display: flex; align-items: center; gap: 22px; }
  .nav-link { color: var(--color-text); text-decoration: none; }

  .menu-btn {
    display: none;
    padding: 4px;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-menu {
    flex-direction: column;
    gap: 4px;
    margin-top: 14px;
    padding-bottom: 6px;
  }
  .mobile-menu:not(.hidden) { display: flex; }
  .mobile-menu .nav-link { padding: 8px 0; color: var(--color-text-secondary); }

  @media (max-width: 640px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .right { gap: 12px; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
