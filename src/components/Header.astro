---
// Site header: mono wordmark, centred nav, "Email me" pill. The homepage
// passes `lang` + `languages` so it can show the EN/TR switcher and Turkish
// labels; inner pages are English-only and use the defaults.
interface Props {
  lang?: 'en' | 'tr';
  languages?: { code: string; label: string; href: string; hrefLang: string }[];
}
const { lang = 'en', languages } = Astro.props;

const LABELS = {
  en: { work: 'Work', writings: 'Writings', notes: 'Notes', projects: 'Projects', about: 'About', email: 'Email me', menu: 'Open menu', home: '/' },
  tr: { work: 'İşler', writings: 'Yazılar', notes: 'Notlar', projects: 'Projeler', about: 'Hakkımda', email: 'Bana yazın', menu: 'Menüyü aç', home: '/tr/' },
}[lang];

const nav = [
  { label: LABELS.work, href: `${LABELS.home}#work` },
  { label: LABELS.writings, href: '/writings' },
  { label: LABELS.notes, href: '/notes' },
  { label: LABELS.projects, href: '/projects' },
  { label: LABELS.about, href: '/about' },
];
---
<header class="site-header">
  <a class="mono brand" href={LABELS.home}>Berkay&nbsp;Çubuk</a>

  <nav class="nav" aria-label="Main">
    {nav.map((n) => <a class="ulink" href={n.href}>{n.label}</a>)}
  </nav>

  <div class="right">
    {languages && (
      <span class="langs mono">
        {languages.map((l) =>
          l.code === lang
            ? <span aria-current="true">{l.label}</span>
            : <a href={l.href} hreflang={l.hrefLang} lang={l.hrefLang}>{l.label}</a>
        )}
      </span>
    )}
    <a class="pill" href="mailto:berkay@berkaycubuk.com">{LABELS.email} ↗</a>
    <button id="menu-btn" class="menu-btn" type="button" aria-label={LABELS.menu} aria-expanded="false" aria-controls="mobile-menu">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" hidden aria-label="Main">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a class="menu-email" href="mailto:berkay@berkaycubuk.com">{LABELS.email} ↗</a>
  </nav>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 20px var(--pad);
    font-size: 14px;
  }
  .brand { text-decoration: none; color: var(--color-text); font-weight: 500; white-space: nowrap; }
  .nav { display: flex; gap: 24px; }
  .right { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .langs { display: flex; gap: 10px; color: var(--color-text-tertiary); }
  .langs a { color: inherit; text-decoration: none; }
  .langs a:hover { color: var(--color-text); }
  .langs [aria-current] { color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }

  .menu-btn { display: none; width: 44px; height: 44px; margin: -10px -12px -10px 0; align-items: center; justify-content: center; padding: 0; border: 0; background: none; color: var(--color-text); cursor: pointer; }
  .mobile-menu { grid-column: 1 / -1; display: flex; flex-direction: column; border-top: 1px solid var(--color-border); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu .menu-email { font-style: italic; }
  .mobile-menu a { padding: 14px 0; border-bottom: 1px solid var(--color-border); font-family: var(--font-display); font-size: 30px; line-height: 1; color: var(--color-text); text-decoration: none; }

  @media (max-width: 900px) {
    .site-header { grid-template-columns: 1fr auto; }
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .right { gap: 12px; }
  }
  @media (max-width: 420px) {
    .pill { display: none; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu!.hidden;
    menu!.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
