---
// Homepage, shared by every language. Copy lives in src/i18n/home.ts.
// Layout: giant serif name + pinned prints, company strip, principles row, numbered
// case-study chapters, process, client quotes, also-made index, contact.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE } from '../data/site';
import { COMPANIES, HOME, LOCALES, QUOTES, type Locale } from '../i18n/home';
import { projects } from '../data/projects';

import fabrikaShot from '../assets/work/fabrika_ai_screenshot.png';
import tamoShot from '../assets/work/tamo_screenshot.png';
import mqttShot from '../assets/work/mqtt_studio_screenshot.png';
import isbusyPhoto from '../assets/work/isbusy_co_photo.jpg';
import pouchShot from '../assets/work/pouch_screenshot.png';
import isbusyCodeShot from '../assets/work/isbusy_code_screenshot.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = HOME[lang];
const here = LOCALES.find((l) => l.code === lang)!;
const canonical = new URL(here.path, SITE.url).href;
const EMAIL = 'berkay@berkaycubuk.com';

// Every language version points at every other one, plus itself, so search
// engines serve the right page per visitor instead of picking one and
// treating the other as duplicate content.
const alternates = [
  ...LOCALES.map((l) => ({
    hrefLang: l.htmlLang,
    href: new URL(l.path, SITE.url).href,
  })),
  { hrefLang: 'x-default', href: new URL('/', SITE.url).href },
];
const languages = LOCALES.map((l) => ({ code: l.code, label: l.label, href: l.path, hrefLang: l.htmlLang }));

// Display headings look wrong when the last line is a single word. Bind the
// final space so the last two words wrap together, whatever the language.
const noWidow = (s: string) => s.replace(/ (\S+)$/, ' $1');
const pad = (i: number) => String(i + 1).padStart(2, '0');

const { paribu, tamo, fabrika } = t.cases;
const cases = [paribu, tamo, fabrika];
// Screenshot shown under each case that has one, by position in `cases`.
const SHOTS_BY_CASE = [undefined, tamoShot, fabrikaShot];

// Also-made index: names and hrefs from data/projects, a peek image where we have one.
const SHOTS = { pouch: pouchShot, 'isbusy code': isbusyCodeShot, 'MQTT Studio': mqttShot, isbusy: isbusyPhoto } as const;
const products = (Object.keys(t.products) as (keyof typeof t.products)[]).map((name) => ({
  name,
  desc: t.products[name],
  href: projects.find((p) => p.title === name)?.links[0]?.href ?? '/projects',
  img: SHOTS[name as keyof typeof SHOTS],
}));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": SITE.nameAscii,
    "url": canonical,
    "inLanguage": here.htmlLang,
    "author": {
      "@type": "Person",
      "name": SITE.nameAscii,
      "url": `${SITE.url}/about`
    },
    "description": t.jsonLdDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.nameAscii,
    "url": SITE.url,
    "jobTitle": t.jobTitle,
    "description": t.jsonLdDescription,
    "email": `mailto:${EMAIL}`,
    "knowsAbout": ["AI agents", "Large language models", "LLM automation", "Agent guardrails", "Multi-agent orchestration"],
    "sameAs": SITE.socials
  },
];
---
<BaseLayout
  title={t.title}
  description={t.description}
  lang={here.htmlLang}
  ogLocale={here.ogLocale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Header lang={lang} languages={languages} />

  <main class="home">
    <p class="sr-only">{t.srIntro}</p>

    <!-- Masthead -->
    <section class="mast">
      <div class="mast-grid">
        <h1>Berkay<br/><span>Çubuk</span></h1>
        <div class="prints">
          <figure class="print p1" role="img" aria-label={t.chat.label}>
            <div class="chat" aria-hidden="true">
              <p class="msg me">{t.chat.ask}</p>
              <p class="msg bot">{t.chat.reply}<br/><b>{t.chat.confirm}</b></p>
              <p class="acts"><span class="yes">{t.chat.yes}</span><span>{t.chat.no}</span></p>
            </div>
            <figcaption class="mono" aria-hidden="true">{t.figA}</figcaption>
          </figure>
          <figure class="print p2" aria-hidden="true">
            <Image src={fabrikaShot} alt="" widths={[300, 600]} sizes="280px" format="webp" quality={70} loading="eager" />
            <figcaption class="mono">{t.figB}</figcaption>
          </figure>
        </div>
      </div>
      <div class="mast-row">
        <p class="role">{t.role[0]}<br/>{t.role[1]}<br/><span>{t.place}</span></p>
        <div>
          <p class="intro">{noWidow(t.heroTitle)}</p>
          <div class="cta-row">
            <a class="btn" href={`mailto:${EMAIL}`}>{t.heroCta} →</a>
            <span class="mono status"><i></i>{t.status}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Companies: the list is rendered twice so the marquee loops seamlessly;
         the copy is hidden from screen readers and keyboard. -->
    <section class="logos" aria-label={t.companiesLabel}>
      <p class="mono logos-label">{t.companiesLabel}</p>
      <div class="marquee">
        {[0, 1].map((copy) => (
          <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {COMPANIES.map((c) => (
              <li>
                {c.href
                  ? <a href={c.href} target="_blank" rel="noopener noreferrer" tabindex={copy === 1 ? -1 : undefined}>{c.logo ? <img src={c.logo} alt={c.name} style={`height:${c.h ?? 28}px`} /> : c.name}</a>
                  : <span>{c.logo ? <img src={c.logo} alt={c.name} style={`height:${c.h ?? 28}px`} /> : c.name}</span>}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <!-- Principles -->
    <section class="principles">
      {t.principles.map((s, i) => (
        <div class="pr">
          <span class="num">{pad(i)}</span>
          <h2>{s.name}</h2>
          <p>{s.desc}</p>
        </div>
      ))}
    </section>

    <!-- Cases -->
    {cases.map((c, i) => (
      <Fragment>
      <section id={i === 0 ? 'work' : undefined} class="chapter">
        <aside class="ch-head">
          <span class="no" aria-hidden="true">{pad(i)}</span>
          <p class="mono meta">{c.client}<br/>{c.tags.join(' · ')}</p>
        </aside>
        <div class="ch-body">
          <h2>{noWidow(c.title)}</h2>
          <dl>
            <dt class="mono">{t.labels.problem}</dt><dd>{c.problem}</dd>
            <dt class="mono">{t.labels.built}</dt><dd>{c.built}</dd>
            <dt class="mono">{t.labels.result}</dt><dd class="res">{c.result}</dd>
          </dl>
          {'link' in c && (
            <a class="arrow" href={c.link.href} target="_blank" rel="noopener noreferrer">{c.link.label} ↗</a>
          )}
        </div>
      </section>
      {'shotAlt' in c && (
        <figure class="annotated">
          <div class="print wide">
            <Image src={SHOTS_BY_CASE[i]!} alt={c.shotAlt} widths={[640, 1000, 1400]} sizes="(max-width: 1000px) 100vw, 920px" format="webp" quality={70} />
          </div>
          <figcaption class="mono">{c.shotCaption}</figcaption>
        </figure>
      )}
      </Fragment>
    ))}

    <!-- Process -->
    <section class="process">
      <h2 class="mono eyebrow">{t.processLabel}</h2>
      <ol>
        {t.steps.map((s, i) => (
          <li><span class="num">{pad(i)}</span><h3>{s.name}</h3><p>{s.desc}</p></li>
        ))}
      </ol>
    </section>

    <!-- Quotes -->
    <section class="words">
      <h2 class="mono eyebrow">{t.wordsLabel}</h2>
      {QUOTES.map((q) => (
        <blockquote lang="en"><p>“{q.text}”</p><cite class="mono"><a href={q.href} target="_blank" rel="noopener noreferrer">{q.by}</a></cite></blockquote>
      ))}
    </section>

    <!-- Also made -->
    <section class="index">
      <h2 class="mono eyebrow">{t.alsoLabel}</h2>
      <ul>
        {products.map((p, i) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener noreferrer">
              <span class="mono n">{pad(i)}</span><span class="t">{p.name}</span><span class="d">{p.desc}</span>
              {p.img && <Image class="peek" src={p.img} alt="" widths={[420]} sizes="300px" format="webp" quality={65} />}
            </a>
          </li>
        ))}
      </ul>
      <a class="arrow all" href="/projects">{t.allProjects} →</a>
    </section>

    <!-- Contact -->
    <section class="end">
      <p class="mono eyebrow">{t.endAsk}</p>
      <a class="write" href={`mailto:${EMAIL}`}>{t.endWrite}</a>
      <p class="addr"><a href={`mailto:${EMAIL}`}>{EMAIL}</a> — {t.endNote}</p>
    </section>
  </main>

  <Footer lang={lang} plain />
</BaseLayout>

<style>
  /* One vertical rhythm for every section, so the page reads as a single system. */
  .home { overflow-x: clip; --space: clamp(80px, 10vw, 160px); }
  .eyebrow { margin: 0 0 clamp(32px, 4vw, 56px); font-weight: 400; }
  .num { font-family: var(--font-display); font-style: italic; font-size: 28px; color: var(--accent); }

  /* --- Masthead --- */
  .mast { padding: 2vw var(--pad) clamp(72px, 8vw, 128px); }
  .mast-grid { display: grid; grid-template-columns: 1fr auto; align-items: center; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: 19vw; line-height: .78; letter-spacing: -0.04em; margin: 0; }
  h1 span { display: block; padding-left: 10vw; font-style: italic; }
  .prints { position: relative; width: 340px; height: 400px; margin-right: 1vw; }
  .p1 { position: absolute; width: 230px; top: 0; left: 0; transform: rotate(-4deg); z-index: 2; }
  .p2 { position: absolute; width: 280px; bottom: 0; right: 0; transform: rotate(3deg); }

  /* Fig. A: a chat drawn in HTML, so it stays sharp and follows the theme. */
  .chat { display: flex; flex-direction: column; gap: 8px; padding: 12px 10px 6px; background: var(--paper); font-size: 13px; line-height: 1.35; }
  .msg { margin: 0; padding: 8px 11px; border-radius: 14px; max-width: 88%; }
  .me { align-self: flex-end; background: var(--ink); color: var(--paper); border-bottom-right-radius: 4px; }
  .bot { align-self: flex-start; background: var(--print); border: 1px solid var(--line); border-bottom-left-radius: 4px; }
  .bot b { font-weight: 600; }
  .acts { margin: 0; display: flex; gap: 6px; }
  .acts span { flex: 1; text-align: center; padding: 6px 0; border: 1px solid var(--line); border-radius: 8px; font-size: 12px; font-weight: 600; }
  .acts .yes { border-color: var(--ok); color: var(--ok); }

  .mast-row { display: grid; grid-template-columns: 1fr 1.6fr; gap: 40px; margin-top: 64px; align-items: end; }
  .role { margin: 0; font-size: 15px; line-height: 1.4; }
  .role span { color: var(--ink-dim); }
  .intro { margin: 0; font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 46px); line-height: 1.08; }
  .cta-row { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; margin-top: 28px; }
  .status { color: var(--ink-dim); display: inline-flex; gap: 8px; align-items: center; font-size: 11px; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 20%, transparent); }

  /* --- Company strip --- */
  .logos { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: clamp(40px, 6vw, 96px); padding: clamp(56px, 6vw, 96px) 0 clamp(56px, 6vw, 96px) var(--pad); border-top: 1px solid var(--line); }
  .logos-label { margin: 0; color: var(--ink-dim); font-size: 11px; white-space: nowrap; }
  .marquee { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; flex-shrink: 0; align-items: center; gap: clamp(64px, 7vw, 112px); margin: 0; padding: 0 clamp(64px, 7vw, 112px) 0 0; list-style: none; animation: marquee 40s linear infinite; }
  .track a, .track span { font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 34px); line-height: 1; color: var(--ink-dim); text-decoration: none; white-space: nowrap; transition: color .2s; }
  .track a:hover, .track a:focus-visible { color: var(--ink); }
  /* Every mark flattened to one ink colour, dimmed to match the wordmarks. Logo
     files must have transparent backgrounds (knock-outs as transparency). */
  .track img { display: block; width: auto; filter: brightness(0); opacity: .55; transition: opacity .2s; }
  :global(.dark) .track img { filter: brightness(0) invert(1); opacity: .6; }
  .track a:hover img, .track a:focus-visible img { opacity: 1; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; row-gap: 14px; }
    .track[aria-hidden] { display: none; }
    .marquee { mask-image: none; }
  }

  /* --- Principles --- */
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pr { padding: clamp(64px, 7vw, 112px) var(--pad); border-right: 1px solid var(--line); }
  .pr:last-child { border-right: 0; }
  .pr h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 2.6vw, 38px); line-height: 1; margin: 20px 0 20px; }
  .pr p { margin: 0; color: var(--ink-dim); max-width: 30em; }

  /* --- Case chapters --- */
  .chapter { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; padding: var(--space) var(--pad) calc(var(--space) * .4); scroll-margin-top: 20px; }
  .ch-head { position: sticky; top: 30px; align-self: start; }
  .no { font-family: var(--font-display); font-size: clamp(100px, 16vw, 240px); line-height: .8; display: block; }
  .meta { color: var(--ink-dim); margin-top: 18px; line-height: 1.7; font-size: 11px; }
  .ch-body { max-width: 42em; }
  .ch-body h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(40px, 6vw, 88px); line-height: .95; letter-spacing: -0.02em; margin: 0 0 56px; }
  dl { margin: 0; display: grid; grid-template-columns: 130px 1fr; gap: 0 24px; }
  dt { color: var(--ink-dim); padding: 24px 0; border-top: 1px solid var(--line); font-size: 11px; line-height: 1.9; }
  dd { margin: 0; padding: 20px 0; border-top: 1px solid var(--line); font-size: 19px; }
  dd.res { font-family: var(--font-display); font-size: clamp(26px, 2.8vw, 36px); line-height: 1.1; font-style: italic; }
  .arrow { display: inline-block; margin-top: 36px; font-weight: 600; color: var(--ink); }

  .annotated { margin: calc(var(--space) * .3) auto var(--space); padding: 0 var(--pad); max-width: 1000px; }
  .wide { transform: rotate(-1deg); padding-bottom: 8px; }
  .annotated > figcaption { margin-top: 28px; color: var(--ink-dim); font-size: 11px; }

  /* --- Process --- */
  .process { padding: var(--space) var(--pad); border-top: 1px solid var(--line); }
  .process ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px; }
  .process h3 { font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1; margin: 12px 0; }
  .process p { margin: 0; color: var(--ink-dim); font-size: 16px; }

  /* --- Quotes --- */
  .words { padding: var(--space) var(--pad); border-top: 1px solid var(--line); }
  .words blockquote { margin: 0; padding: 48px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 3fr 1fr; gap: 30px; align-items: end; }
  .words p { margin: 0; font-family: var(--font-display); font-size: clamp(26px, 3.6vw, 50px); line-height: 1.08; }
  .words cite { font-style: normal; text-align: right; }
  .words cite a { color: var(--ink); }

  /* --- Also-made index --- */
  .index { padding: 0 var(--pad) var(--space); }
  .index ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .index li a { display: grid; grid-template-columns: 60px 1fr 1.4fr; gap: 20px; align-items: baseline; padding: 28px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; position: relative; transition: padding .3s; }
  .n { color: var(--ink-dim); }
  .t { font-family: var(--font-display); font-size: clamp(30px, 4vw, 54px); line-height: 1; }
  .d { color: var(--ink-dim); }
  .peek { position: absolute; right: 4%; top: 50%; width: 300px; height: auto; transform: translateY(-50%) rotate(3deg) scale(.9); opacity: 0; pointer-events: none; transition: opacity .25s, transform .35s; box-shadow: 0 20px 50px -20px rgba(0,0,0,.5); border: 6px solid var(--print); z-index: 2; }
  .all { margin-top: 32px; }
  @media (pointer: coarse) { .arrow { padding-block: 10px; margin-top: 16px; } }

  /* --- Contact --- */
  .end { padding: var(--space) var(--pad) 40px; border-top: 1px solid var(--line); }
  .write { display: block; font-family: var(--font-display); font-size: clamp(64px, 15vw, 240px); line-height: .85; letter-spacing: -0.03em; color: var(--ink); text-decoration: none; font-style: italic; transition: letter-spacing .4s; }
  .addr { color: var(--ink-dim); margin-top: 40px; font-size: 15px; }
  .addr a { color: var(--ink); }

  /* Hover effects only where there's a real pointer, so they don't stick after a tap. */
  @media (hover: hover) {
    .print:hover { transform: rotate(0) translateY(-4px); z-index: 3; }
    .index li a:hover { padding-left: 14px; }
    .index li a:hover .peek { opacity: 1; transform: translateY(-50%) rotate(-2deg) scale(1); }
    .write:hover { letter-spacing: -0.01em; }
  }

  /* Scroll reveal: CSS-only, skipped where unsupported or motion is reduced. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ch-body dl > *, .ch-body h2, .words blockquote, .process li { animation: fade linear both; animation-timeline: view(); animation-range: entry 0% entry 50%; }
      @keyframes fade { from { opacity: 0; transform: translateY(20px); } }
    }
  }

  /* Tablet: name and prints stay side by side, prints shrink. */
  @media (max-width: 900px) {
    .prints { width: 260px; height: 330px; }
    .p1 { width: 190px; } .p2 { width: 210px; }
    .chat { font-size: 11px; gap: 6px; }
  }
  /* Phone: prints drop below the name, side by side. */
  @media (max-width: 600px) {
    .mast-grid { grid-template-columns: 1fr; }
    .prints { width: 100%; height: 250px; margin: 24px 0 0; }
    .p1 { width: min(54%, 220px); left: 2%; } .p2 { width: min(52%, 240px); right: 2%; }
    .print > figcaption { font-size: 9px; letter-spacing: 0; }
  }

  @media (max-width: 900px) {
    .mast-row, .chapter, .principles, .words blockquote { grid-template-columns: 1fr; }
    .pr { border-right: 0; border-top: 1px solid var(--line); }
    .pr:first-child { border-top: 0; }
    .logos { grid-template-columns: 1fr; gap: 14px; }
    .ch-head { position: static; }
    .process ol { grid-template-columns: 1fr 1fr; gap: 40px 28px; }
    dl { grid-template-columns: 1fr; } dd { border-top: 0; padding-top: 0; } dt { padding-bottom: 6px; }
    .index li a { grid-template-columns: 40px 1fr; } .d { grid-column: 2; } .peek { display: none; }
    .words cite { text-align: left; }
  }
</style>
