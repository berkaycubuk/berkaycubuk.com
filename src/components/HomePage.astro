---
// Homepage, shared by every language. Copy lives in src/i18n/home.ts.
// Built to be understood in a few seconds: bold sans headline, short lines, content
// in cards, one bright button repeated. It deliberately departs from the editorial
// serif look of the inner pages; colours still come from the site tokens so the
// theme toggle keeps working.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE } from '../data/site';
import { COMPANIES, HOME, LOCALES, type Locale } from '../i18n/home';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = HOME[lang];
const here = LOCALES.find((l) => l.code === lang)!;
const canonical = new URL(here.path, SITE.url).href;
const EMAIL = 'berkay@berkaycubuk.com';
// Every CTA opens an email with the subject filled in, so intro-call requests are easy to spot.
const BOOK = `mailto:${EMAIL}?subject=${encodeURIComponent(t.mailSubject)}`;
const workPath = lang === 'en' ? '/work' : `/${lang}/work`;

// Every language version points at every other one, plus itself, so search
// engines serve the right page per visitor instead of picking one and
// treating the other as duplicate content.
const alternates = [
  ...LOCALES.map((l) => ({
    hrefLang: l.htmlLang,
    href: new URL(l.path, SITE.url).href,
  })),
  { hrefLang: 'x-default', href: new URL('/', SITE.url).href },
];
const languages = LOCALES.map((l) => ({ code: l.code, label: l.label, href: l.path, hrefLang: l.htmlLang }));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": SITE.nameAscii,
    "url": canonical,
    "inLanguage": here.htmlLang,
    "author": {
      "@type": "Person",
      "name": SITE.nameAscii,
      "url": `${SITE.url}/about`
    },
    "description": t.jsonLdDescription
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.nameAscii,
    "url": SITE.url,
    "jobTitle": t.jobTitle,
    "description": t.jsonLdDescription,
    "email": `mailto:${EMAIL}`,
    "knowsAbout": ["AI agents", "Large language models", "LLM automation", "Agent guardrails", "Multi-agent orchestration"],
    "sameAs": SITE.socials
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": here.htmlLang,
    "mainEntity": t.faq.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
];
---
<BaseLayout
  title={t.title}
  description={t.description}
  lang={here.htmlLang}
  ogLocale={here.ogLocale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Header lang={lang} languages={languages} />

  <main class="home">
    <p class="sr-only">{t.srIntro}</p>

    <section class="hero">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.heroTitle}</h1>
      <ul class="points">
        {t.heroPoints.map((p) => <li>{p}</li>)}
      </ul>
      <p class="sub">{t.heroSub}</p>
      <a class="go big" href={BOOK}>{t.heroCta} →</a>
      <p class="small">{t.heroNote} <span class="status"><i></i>{t.status}</span></p>
    </section>

    <!-- Companies: the list is rendered twice so the slider loops seamlessly;
         the copy is hidden from screen readers and keyboard. -->
    <section class="clients" aria-label={t.companiesLabel}>
      <p class="clients-label">{t.companiesLabel}</p>
      <div class="marquee">
        {[0, 1].map((copy) => (
          <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {COMPANIES.map((c) => {
              const mark = c.logo ? <img src={c.logo} alt={c.name} draggable="false" style={`height:${c.h ?? 28}px`} /> : c.name;
              return (
                <li>
                  {c.href
                    ? <a href={c.href} target="_blank" rel="noopener noreferrer" tabindex={copy === 1 ? -1 : undefined}>{mark}</a>
                    : <span>{mark}</span>}
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </section>

    <section>
      <h2>{t.examplesLabel}</h2>
      <div class="grid g2">
        {t.examples.map((e) => (
          <div class="card">
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
          </div>
        ))}
      </div>
      <p class="small center">{t.examplesNote}</p>
    </section>

    <section>
      <h2>{t.processLabel}</h2>
      <ol class="grid g3">
        {t.steps.map((s, i) => (
          <li class="card">
            <span class="n">{i + 1}</span>
            <h3>{s.name}</h3>
            <p class="tag">{s.meta}</p>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>{t.includedLabel}</h2>
      <ul class="checks">
        {t.included.map((item) => <li>{item}</li>)}
      </ul>
      <div class="card strong">
        <h3>{t.guaranteeLabel}</h3>
        <p>{t.guarantee}</p>
      </div>
    </section>

    <section id="pricing">
      <h2>{t.pricingLabel}</h2>
      <div class="card price">
        <p class="tag">{t.priceLead}</p>
        <p class="amount">{t.price}</p>
        <p class="was"><s>{t.priceWas}</s> · {t.priceNote}</p>
        <p>{t.payback}</p>
        <p class="small">{t.careNote}</p>
        <a class="go" href={BOOK}>{t.heroCta} →</a>
      </div>
    </section>

    <section id="work">
      <h2>{t.proofLabel}</h2>
      <p class="lead">{t.proofIntro}</p>
      <ul class="checks">
        {t.proof.map((p) => <li>{p}</li>)}
      </ul>
      <a class="more" href={workPath}>{t.allWork} →</a>
    </section>

    <section>
      <h2>{t.faqLabel}</h2>
      <div class="faq">
        {t.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="end">
      <h2>{t.endAsk}</h2>
      <p>{t.endNote}</p>
      <a class="go big" href={BOOK}>{t.heroCta} →</a>
      <p class="small"><a href={BOOK}>{EMAIL}</a></p>
    </section>
  </main>

  <Footer lang={lang} plain />
</BaseLayout>

<script>
  // Company slider: drives the scroll from JS so it can also be dragged with the
  // mouse or a finger. Without JS the CSS animation runs instead; with reduced
  // motion the logos sit still in a wrapped row (see CSS) and this does nothing.
  const SPEED = 40; // px per second
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.marquee').forEach((m) => {
    const first = m.querySelector<HTMLElement>('.track');
    if (reduce || !first) return;
    m.classList.add('is-js');

    let x = 0;
    let last = performance.now();
    let hover = false;
    let dragging = false;
    let startX = 0;
    let startPos = 0;
    let moved = 0;

    // Two identical tracks: wrapping by one track's width loops without a seam.
    const tick = (now: number) => {
      if (!dragging && !hover) x += (SPEED * (now - last)) / 1000;
      last = now;
      const w = first.offsetWidth;
      if (w) x = ((x % w) + w) % w;
      m.scrollLeft = x;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    m.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    m.addEventListener('pointerleave', () => { hover = false; });
    m.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startPos = x;
    });
    m.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      // Capture only once it's clearly a drag, so a plain click still opens the logo's link.
      if (moved <= 5 && Math.abs(dx) > 5) {
        m.setPointerCapture(e.pointerId);
        m.classList.add('dragging');
      }
      moved = Math.max(moved, Math.abs(dx));
      x = startPos - dx;
    });
    const end = () => {
      dragging = false;
      m.classList.remove('dragging');
    };
    m.addEventListener('pointerup', end);
    m.addEventListener('pointercancel', end);
    // A drag that ends on a logo shouldn't also follow its link.
    m.addEventListener('click', (e) => {
      if (moved > 5) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  });
</script>

<style>
  /* min-width: 0 stops the logo track from stretching the page inside the layout's flex body. */
  .home { width: 100%; min-width: 0; box-sizing: border-box; max-width: calc(960px + 2 * var(--pad)); margin: 0 auto; padding: 0 var(--pad); font-family: var(--font-body); font-size: 18px; line-height: 1.55; }
  section { padding: 64px 0; }
  /* Zero specificity, so the class rules below can set their own margins. */
  :where(.home p) { margin: 0 0 14px; }

  h1, h2, h3 { font-family: var(--font-body); color: var(--ink); margin: 0; }
  h1 { font-size: clamp(40px, 6.2vw, 68px); font-weight: 700; line-height: 1.05; letter-spacing: -0.035em; max-width: 13em; margin-bottom: 28px; }
  h2 { font-size: clamp(28px, 3.6vw, 38px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; margin-bottom: 28px; }
  h3 { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; }

  .small { font-size: 15px; color: var(--ink-dim); }
  .center { text-align: center; margin-top: 24px; }
  .lead { font-size: 20px; margin-bottom: 20px; }

  /* --- Hero --- */
  .hero { padding: clamp(48px, 9vw, 112px) 0 48px; }
  .eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim); margin-bottom: 20px; }
  .points { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .points li { padding: 8px 16px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); font-weight: 600; font-size: 16px; }
  .sub { font-size: 21px; color: var(--ink-dim); max-width: 32em; margin-bottom: 32px; }
  .status { display: inline-flex; align-items: center; gap: 8px; margin-left: 12px; color: var(--ink); }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }

  /* The one loud element on the page. */
  .go { display: inline-block; padding: 14px 24px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; font-size: 17px; text-decoration: none; transition: transform .15s, filter .15s; }
  .go.big { padding: 18px 32px; font-size: 19px; margin-bottom: 16px; }
  @media (hover: hover) { .go:hover { transform: translateY(-2px); filter: brightness(1.08); } }

  /* --- Company slider --- */
  .clients { padding: 32px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .clients-label { margin: 0 0 20px; font-size: 15px; font-weight: 600; text-align: center; color: var(--ink-dim); }
  .marquee { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; flex-shrink: 0; align-items: center; gap: 72px; margin: 0; padding: 0 72px 0 0; list-style: none; animation: marquee 30s linear infinite; }
  .track li { display: flex; align-items: center; height: 44px; }
  .track a, .track span { font-weight: 600; font-size: 22px; letter-spacing: -0.01em; color: var(--ink-dim); text-decoration: none; white-space: nowrap; transition: color .2s; }
  .track a:hover, .track a:focus-visible { color: var(--ink); }
  /* Every mark flattened to one ink colour so mixed logos look like one set. Logo
     files must have transparent backgrounds (knock-outs as transparency). */
  .track img { display: block; width: auto; filter: brightness(0); opacity: .6; transition: opacity .2s; }
  :global(.dark) .track img { filter: brightness(0) invert(1); opacity: .7; }
  .track a:hover img, .track a:focus-visible img { opacity: 1; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  /* With JS the script moves the slider and lets you drag it. */
  .marquee.is-js { cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .marquee.is-js .track { animation: none; }
  .marquee.dragging { cursor: grabbing; }
  .marquee.dragging a { pointer-events: none; }
  @keyframes marquee { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; justify-content: center; row-gap: 16px; padding: 0; }
    .track[aria-hidden] { display: none; }
    .marquee { mask-image: none; justify-content: center; }
  }

  /* --- Cards --- */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .g2 { grid-template-columns: repeat(2, 1fr); }
  .g3 { grid-template-columns: repeat(3, 1fr); }
  .card { background: var(--print); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .card p:last-child { margin-bottom: 0; }
  .card p { color: var(--ink-dim); font-size: 17px; }
  .n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--paper); font-weight: 700; margin-bottom: 16px; }
  .card .tag { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); margin-bottom: 10px; }
  .strong { border: 2px solid var(--ok); margin-top: 24px; }
  .strong p { color: var(--ink); font-size: 19px; }

  .checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 32px; }
  .checks li { padding-left: 32px; position: relative; }
  .checks li::before { content: '✓'; position: absolute; left: 0; top: 1px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 700; color: #fff; background: var(--ok); }
  #work .checks { grid-template-columns: 1fr; }

  /* --- Price --- */
  .price { border: 2px solid var(--accent); padding: clamp(24px, 4vw, 40px); }
  .price .amount { font-size: clamp(40px, 6vw, 56px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--ink); margin-bottom: 12px; }
  .price .was { font-size: 16px; }
  .price p:nth-last-of-type(2) { color: var(--ink); }
  .price .go { margin-top: 12px; }

  .more { display: inline-block; margin-top: 24px; font-weight: 600; color: var(--ink); }

  /* --- FAQ --- */
  .faq { display: grid; gap: 10px; }
  .faq details { background: var(--print); border: 1px solid var(--line); border-radius: 12px; padding: 0 20px; }
  .faq summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; position: relative; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 14px; font-size: 22px; color: var(--ink-dim); }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { color: var(--ink-dim); margin-bottom: 18px; }

  .end { text-align: center; padding: 80px 0 112px; }
  .end p { font-size: 20px; color: var(--ink-dim); }
  .end .go { margin-top: 12px; }
  .end a:not(.go) { color: var(--ink-dim); }

  @media (max-width: 760px) {
    .g2, .g3, .checks { grid-template-columns: 1fr; }
    .status { display: flex; margin: 10px 0 0; }
    section { padding: 48px 0; }
  }
</style>
